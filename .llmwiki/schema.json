{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leanix:llm-wiki:okf-v0.2",
  "$ref": "#/$defs/llmwikiFrontmatter",
  "title": "OKF v0.2 and llm-wiki frontmatter",
  "description": "Portable OKF v0.2 frontmatter with an explicit llm-wiki profile. Use #/$defs/okfFrontmatter for the permissive OKF contract or #/$defs/llmwikiFrontmatter for plugin-generated pages.",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp with an explicit UTC offset. New llm-wiki values use the Z suffix."
    },
    "legacyDateOrTimestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Legacy date-only form accepted during migration."
        }
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "Identity using the OKF actor convention: producer/version, human:id, or process:id."
    },
    "sourceEntry": {
      "type": "object",
      "description": "A material from which a concept derives. resource is the only required entry field.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable key used to attribute claims through Markdown footnotes."
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "URL, bundle-relative path, or scope descriptor for the source material."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable source label."
        },
        "author": {
          "$ref": "#/$defs/actor",
          "description": "Optional authority signal describing who or what produced the source."
        },
        "usage_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional coarse liveness/adoption signal framed by usage_window."
        },
        "last_modified": {
          "$ref": "#/$defs/legacyDateOrTimestamp",
          "description": "Optional timestamp for the last change to the source itself."
        },
        "usage_window": {
          "$ref": "#/$defs/usageWindow",
          "description": "Optional per-source override for the sibling usage_window."
        }
      },
      "required": [
        "resource"
      ],
      "additionalProperties": true
    },
    "sourceRevision": {
      "type": "object",
      "description": "The provider-native revision represented by a Source page.",
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1,
          "description": "Provider revision scheme, such as confluence-version or http-etag."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "The provider's revision value, kept as a string."
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "additionalProperties": false
    },
    "syncStatus": {
      "type": "string",
      "enum": [
        "in_sync",
        "partial",
        "blocked",
        "removed",
        "immutable"
      ],
      "description": "Whether a Source page is synchronized with its mutable provider source."
    },
    "usageWindow": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/legacyDateOrTimestamp",
          "description": "Beginning of the usage measurement window."
        },
        "to": {
          "$ref": "#/$defs/legacyDateOrTimestamp",
          "description": "End of the usage measurement window."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": true
    },
    "generated": {
      "type": "object",
      "description": "The original actor and time that produced the page content.",
      "properties": {
        "by": {
          "$ref": "#/$defs/actor",
          "description": "Actor that produced the current content."
        },
        "at": {
          "$ref": "#/$defs/timestamp",
          "description": "When the original page content was produced."
        }
      },
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": true
    },
    "updated": {
      "type": "object",
      "description": "The actor and time of the latest persisted page update, distinct from original generation.",
      "properties": {
        "by": {
          "$ref": "#/$defs/actor",
          "description": "Actor that last persisted a page update."
        },
        "at": {
          "$ref": "#/$defs/timestamp",
          "description": "When the latest page update was persisted."
        }
      },
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": true
    },
    "verifiedEntry": {
      "type": "object",
      "description": "One independent confirmation of a concept against its sources or resource.",
      "properties": {
        "by": {
          "$ref": "#/$defs/actor",
          "description": "Actor that performed the verification."
        },
        "at": {
          "$ref": "#/$defs/timestamp",
          "description": "When the verification occurred."
        }
      },
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": true
    },
    "verified": {
      "oneOf": [
        {
          "$ref": "#/$defs/verifiedEntry"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verifiedEntry"
          },
          "minItems": 0,
          "description": "List of independent verification events; an empty list means the page has not been verified."
        }
      ],
      "description": "Optional verification record. A bare mapping is equivalent to a one-element list."
    },
    "commonProperties": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable display name for the concept."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "One-sentence summary used by indexes, previews, and search snippets."
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical URI or path identifying the underlying asset. Optional for abstract concepts."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Short strings for cross-cutting categorization."
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceEntry"
          },
          "description": "Materials from which the concept derives."
        },
        "usage_window": {
          "$ref": "#/$defs/usageWindow",
          "description": "Shared measurement window for source usage_count signals."
        },
        "generated": {
          "$ref": "#/$defs/generated",
          "description": "Production metadata for the current content."
        },
        "updated": {
          "$ref": "#/$defs/updated",
          "description": "Latest persisted update metadata, distinct from original generation."
        },
        "verified": {
          "$ref": "#/$defs/verified"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "stable",
            "deprecated"
          ],
          "default": "stable",
          "description": "Lifecycle state. Absence means stable under OKF."
        },
        "stale_after": {
          "$ref": "#/$defs/legacyDateOrTimestamp",
          "description": "Absolute instant after which the concept is stale. New values should use ISO-8601 date-time."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "SHA-256 digest used by llm-wiki Source pages to detect source drift."
        }
      }
    },
    "okfFrontmatter": {
      "type": "object",
      "description": "Permissive OKF v0.2 concept frontmatter. Only type is required; unknown fields and types are allowed.",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty producer-defined concept type. Consumers must tolerate unknown values."
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/commonProperties"
        }
      ],
      "additionalProperties": true,
      "examples": [
        {
          "type": "Reference"
        },
        {
          "type": "Playbook",
          "title": "Data freshness response",
          "tags": [
            "oncall"
          ]
        }
      ]
    },
    "llmwikiFrontmatter": {
      "type": "object",
      "description": "llm-wiki's stricter profile over OKF v0.2. Known types receive plugin conventions; unknown types remain structurally consumable.",
      "allOf": [
        {
          "$ref": "#/$defs/okfFrontmatter"
        },
        {
          "properties": {
            "source_revision": {
              "$ref": "#/$defs/sourceRevision"
            },
            "sync_status": {
              "$ref": "#/$defs/syncStatus"
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "Service",
                  "Module",
                  "API",
                  "Datastore",
                  "Runbook",
                  "Decision",
                  "Convention",
                  "DeprecatedPattern",
                  "GlossaryTerm"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "description",
              "tags",
              "status",
              "generated"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "Service",
                  "Module",
                  "API",
                  "Datastore",
                  "Runbook",
                  "Decision",
                  "Convention",
                  "DeprecatedPattern",
                  "GlossaryTerm"
                ]
              },
              "tags": {
                "not": {
                  "contains": {
                    "const": "overview"
                  }
                }
              }
            },
            "required": [
              "type",
              "tags"
            ]
          },
          "then": {
            "required": [
              "resource"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Query"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "description",
              "tags",
              "status",
              "generated"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Source"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "resource",
              "sha256",
              "status",
              "generated",
              "sources",
              "sync_status"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "sync_status": {
                      "const": "immutable"
                    }
                  },
                  "required": [
                    "sync_status"
                  ]
                },
                "else": {
                  "required": [
                    "source_revision"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "DeprecatedPattern"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "deprecated"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      ],
      "examples": [
        {
          "type": "Module",
          "title": "Authentication",
          "description": "Authentication and session management.",
          "resource": "src/auth/",
          "tags": [
            "security"
          ],
          "status": "stable",
          "generated": {
            "by": "llm-wiki-maintainer/claude-sonnet-4-6",
            "at": "2026-09-29T12:00:00Z"
          }
        },
        {
          "type": "Module",
          "title": "Project overview",
          "description": "High-level project context.",
          "tags": [
            "overview"
          ],
          "status": "stable",
          "generated": {
            "by": "llm-wiki-maintainer/claude-sonnet-4-6",
            "at": "2026-09-29T12:00:00Z"
          }
        }
      ]
    },
    "rootIndexFrontmatter": {
      "type": "object",
      "description": "Optional frontmatter for the bundle-root index.md. Other index.md files have no frontmatter.",
      "properties": {
        "okf_version": {
          "const": "0.2",
          "description": "Declares the target OKF bundle version."
        }
      },
      "required": [
        "okf_version"
      ],
      "additionalProperties": false
    }
  }
}
