{
  "enabled": true,
  "extends": [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    "local>leanix/.github//renovate-presets/security.json5"
  ],
  "prHourlyLimit": 10,
  "branchConcurrentLimit": 0,
  "rebaseWhen": "conflicted",
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "labels": ["major version update"]
    },
    {
      "matchPackageNames": [
        "io.kubernetes:client-java"
      ],
      "allowedVersions": "!/.*-legacy$/"
    },
    {
      "matchPackageNames": [
        "org.liquibase:*",
        "liquibase*"
      ],
      "matchDatasources": [
        "maven",
        "docker"
      ],
      "allowedVersions": "<5.0"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "gradle/*"
      ],
      "allowedVersions": "<6"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "axios"
      ],
      "allowedVersions": "!/(1\\.14\\.1)|(0\\.30\\.4)/"
    },
    {
      "matchDatasources": [
        "maven"
      ],
      "registryUrls": [
        "https://common.repositories.cloud.sap/artifactory/maven-central",
        "https://common.repositories.cloud.sap/artifactory/plugins.gradle.org-m2"
      ]
    }
  ],
  // Provide an encrypted PAT for renovate to access dependencies in private repositories
  // This is mainly used for updating our internal Github actions and workflows
  //
  // The PAT expires every year and needs to be renewed as described here:
  // https://github.tools.sap/OSPO/renovate-controller/blob/9680b17e8e4e18a9e47d7cc89efe251c189807ee/docs/encrypted-secrets-private-modules.md#team-private-modules
  "hostRules": [
    {
      "matchHost": "https://github.tools.sap",
      "encrypted": {
        "token": ""
      }
    }
  ]
}
