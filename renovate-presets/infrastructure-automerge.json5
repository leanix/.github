/*
Prerequisites for this preset:
 - "Allow auto-merge" enabled in repository settings
 - Github App "renovate-approve" installed on the repository
 - Required CI workflows triggered on push to renovate's branches
 - CI workflow trigger on `merge_group:` event or on push to temporary merge queue branches *(Only if Merge Queue enabled)*

Extends automerge but disables automerge for Terraform and Terraform provider updates,
which typically require manual review due to infrastructure impact.
*/
{
  extends: ["local>leanix/.github//renovate-presets/automerge.json5"],
  packageRules: [
    {
      // Terraform modules and providers require manual review
      matchManagers: ["terraform", "terraform-version", "terragrunt"],
      automerge: false,
      platformAutomerge: false,
    },
  ],
}
